<style>
        @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700;800&display=swap');
        html { scroll-behavior: smooth; }
        body {
            background-color: #FFFFFF;
            color: #000000;
            -webkit-font-smoothing: antialiased;
        }
        .glass-panel {
            background: #FFFFFF;
            border: 1.5px solid #E0E0E0;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
            transition: box-shadow 0.3s ease, transform 0.3s ease;
        }
        .glass-panel:hover {
            border-color: #3D42C9;
            box-shadow: 0 12px 32px rgba(61, 66, 201, 0.15);
        }
        .hero-gradient {
            background: #FFFFFF;
        }
        .font-rubik {
            font-family: 'Rubik', sans-serif;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Section background variations — ALTERNANCIA CON CONTRASTE REAL */
        .bg-section-white { background: #FFFFFF; }
        .bg-section-gray { background: #F0F0F0; }
        .bg-section-tinted {
            background:
                radial-gradient(ellipse at 80% 20%, rgba(61, 66, 201, 0.10) 0%, transparent 55%),
                #F5F5F5;
        }
        .bg-glow-primary {
            background:
                radial-gradient(ellipse at 80% 20%, rgba(61, 66, 201, 0.10) 0%, transparent 55%),
                #F5F5F5;
        }
        .bg-glow-primary-left {
            background:
                radial-gradient(ellipse at 15% 80%, rgba(61, 66, 201, 0.10) 0%, transparent 55%),
                #F5F5F5;
        }
        .bg-grid-pattern {
            background-color: #F0F0F0;
            background-image:
                linear-gradient(rgba(61, 66, 201, 0.10) 1px, transparent 1px),
                linear-gradient(90deg, rgba(61, 66, 201, 0.10) 1px, transparent 1px);
            background-size: 48px 48px;
        }
        .bg-dots-pattern {
            background-color: #F0F0F0;
            background-image: radial-gradient(rgba(61, 66, 201, 0.20) 1.5px, transparent 2px);
            background-size: 28px 28px;
        }
        .bg-deep-navy {
            background: #EFEFEF;
        }
        .bg-gradient-cta {
            background: linear-gradient(135deg, #3D42C9 0%, #5B5FE8 50%, #EB9360 100%);
        }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
