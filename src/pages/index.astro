<script is:inline>
(function () {
  var carousel = document.getElementById('cap-carousel');
  if (!carousel) return;
  var slides = carousel.querySelectorAll('[data-cap-slide]');
  var dots = document.querySelectorAll('[data-cap-dot]');
  var current = 0;

  function updateDots() {
    dots.forEach(function (d, i) {
      if (i === current) {
        d.classList.remove('bg-primary/30', 'hover:bg-primary/60');
        d.classList.add('bg-primary');
      } else {
        d.classList.remove('bg-primary');
        d.classList.add('bg-primary/30', 'hover:bg-primary/60');
      }
    });
  }

  function scrollToSlide(idx) {
    idx = ((idx % slides.length) + slides.length) % slides.length;
    current = idx;
    var slide = slides[idx];
    var offset = slide.offsetLeft - (carousel.clientWidth - slide.clientWidth) / 2;
    carousel.scrollTo({ left: offset, behavior: 'smooth' });
    updateDots();
  }

  // Click en dots — navega a slide específico (pausa autoplay 6s)
  var resumeTimer = null;
  dots.forEach(function (d) {
    d.addEventListener('click', function () {
      scrollToSlide(parseInt(d.dataset.capDot, 10));
      stopAutoplay();
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(startAutoplay, 6000);
    });
  });

  // Keep dots in sync when user swipes/scrolls manually
  var scrollTimeout;
  carousel.addEventListener('scroll', function () {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(function () {
      var center = carousel.scrollLeft + carousel.clientWidth / 2;
      var closest = 0, minDist = Infinity;
      slides.forEach(function (s, i) {
        var slideCenter = s.offsetLeft + s.offsetWidth / 2;
        var dist = Math.abs(slideCenter - center);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      if (closest !== current) { current = closest; updateDots(); }
    }, 100);
  });

  // Autoplay continuo cada 4s. NO pausa por hover. Loop infinito.
  var autoplayTimer = null;
  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(function () {
      scrollToSlide(current + 1);
    }, 4000);
  }
  function stopAutoplay() {
    if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
  }
  // Pausa solo cuando la pestaña no es visible (no gastes ciclos)
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopAutoplay();
    else startAutoplay();
  });
  // Inicia inmediato
  startAutoplay();
})();

// ─── Contact Modal ────────────────────────────────────────────
(function () {
  var modal = document.getElementById('contact-modal');
  var openBtn = document.getElementById('open-contact-modal');
  var closeBtn = document.getElementById('close-contact-modal');
  var form = document.getElementById('contact-form');
  if (!modal || !openBtn || !form) return;

  function openModal() {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    setTimeout(function () { document.getElementById('cf-nombre').focus(); }, 50);
  }
  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  openBtn.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
  });

  });
})();
</script>
</body></html>
